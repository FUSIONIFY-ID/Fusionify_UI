      "white": "#0f2040",
      "line": "#1f3459",
      "night": "#071022",
      "go": "#7fe0a6",
      "goBg": "#0f3324",
      "beta": "#ffd27a",
      "betaBg": "#3a2a08",
      "wip": "#ffb98a",
      "wipBg": "#3c220e",
      "plan": "#a9d0ff",
      "planBg": "#10264a",
      "eos": "#b5c0d0",
      "eosBg": "#1c2638",
      "card": "#10203f",
      "field": "#0b1830",
