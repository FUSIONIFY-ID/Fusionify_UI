      "navGlass": "#0a162cd1",
      "heroGlow": "#0f2a55",
      "sealTint": "#15315c",
      "danger": "#ff9ba1",
      "dangerBg": "#3d1418",
      "placeholder": "#8597b3",
      "footerTop": "#1f3459"
    }
  },
  "radius": {
    "s": 10,
    "m": 18,
    "l": 28,
    "pill": 999
  },
  "font": {
    "head": {
      "family": "Afacad Flux",
      "file": "AfacadFlux-ExtraBold.ttf",
      "weight": 800,
      "use": "judul",
      "letterSpacingEm": -0.025,
      "lineHeight": 0.98
    },
    "body": {
      "family": "Sansation",
      "files": {
        "400": "Sansation-Regular.ttf",
        "700": "Sansation-Bold.ttf"
      },
      "size": 17,
      "lineHeight": 1.6,
      "use": "teks dan UI"
    },
    "hand": {
      "family": "Caveat",
      "files": {
        "400": "Caveat-Regular.ttf",
        "700": "Caveat-Bold.ttf"
      },
      "use": "suara maskot"
    },
    "num": {
      "family": "Exo 2",
      "files": {
        "400": "Exo2-Regular.ttf",
        "600": "Exo2-SemiBold.ttf",
        "700": "Exo2-Bold.ttf"
      },
      "use": "angka (tabular) dan label kecil kapital"
    }
  },
  "sticker": {
    "borderWidth": 2,
    "borderColor": "edge",
    "shadowButton": {
      "x": 0,
      "y": 3,
      "blur": 0,
      "color": "edgeShadow"
    },
    "shadowCard": {
      "x": 0,
      "y": 6,
      "blur": 0,
      "color": "edgeShadow"
    },
    "note": "Bayangan pejal: offset ke bawah tanpa blur. Garis 2px warna edge. Jangan pakai elevation/blur bawaan platform."
  },
  "motion": {
    "ease": [
      0.22,
      1,
      0.36,
      1
    ],
    "spring": [
      0.34,
      1.56,
      0.64,
      1
    ],
    "durationMs": {
      "fast": 200,
      "base": 350,
      "slow": 450
    },
    "note": "Hormati pengaturan kurangi gerakan di HP (iOS Reduce Motion, Android Remove animations)."
  },
  "touch": {
    "minTarget": 44,
    "navBarHeight": 76,
    "railWidth": 92,
    "appBarHeight": 64,
    "gutter": 16
  }
}
